  Future<List<DartCompletionItem>> complete({
    required String path,
    required int line,
    required int character,
  }) async {
    _ensureInitialized();

    final normalizedPath =
        _normalizePath(path);

    final serverPath =
        _client.convertPathToServerPath(
      normalizedPath,
    );

    final uri =
        Uri.file(serverPath);

    final uriString =
        uri.toString();

    final safeLine =
        line < 0 ? 0 : line;

    final safeCharacter =
        character < 0
            ? 0
            : character;

    final currentVersion =
        _documentVersions[uriString];

    final currentText =
        _documentTexts[uriString];

    final isOpen =
        _openDocuments.contains(
      uriString,
    );

    _log(
      '==================================================',
    );

    _log(
      '[Completion] INÍCIO',
    );

    unawaited(
      EditorAutocompleteFileLogger.lspTarget(
        path: normalizedPath,
        uri: uriString,
        line: safeLine,
        character: safeCharacter,
        version: currentVersion,
        isOpen: isOpen,
        textState:
            currentText == null
                ? 'text=-'
                : 'lines=${_countLines(currentText)} '
                  'chars=${currentText.length} '
                  'endsWithNewline='
                  '${currentText.endsWith('\n')} '
                  'tail=${_textTail(currentText)}',
      ),
    );

    _log(
      '[Completion] path Android: '
      '$normalizedPath',
    );

    _log(
      '[Completion] path PRoot: '
      '$serverPath',
    );

    _log(
      '[Completion] URI: '
      '$uriString',
    );

    _log(
      '[Completion] posição: '
      '$safeLine:$safeCharacter',
    );

    _log(
      '[Completion] documento aberto: '
      '$isOpen',
    );

    _log(
      '[Completion] versão atual: '
      '$currentVersion',
    );

    _log(
      '[Completion] enviando '
      'textDocument/completion...',
    );

    try {
      final result =
          await _client.sendRequest(
        'textDocument/completion',
        <String, dynamic>{
          'textDocument':
              <String, dynamic>{
            'uri':
                uriString,
          },
          'position':
              <String, dynamic>{
            'line':
                safeLine,
            'character':
                safeCharacter,
          },
          'context':
              <String, dynamic>{
            'triggerKind':
                1,
          },
        },
      ).timeout(
        const Duration(
          seconds: 5,
        ),
      );

      final completions =
          _parseCompletionResult(
        result,
      );

      unawaited(
        EditorAutocompleteFileLogger.completionResult(
          count: completions.length,
          line: safeLine,
          character: safeCharacter,
        ),
      );

      _log(
        '[Completion] resposta recebida.',
      );

      _log(
        '[Completion] sugestões interpretadas: '
        '${completions.length}',
      );

      if (completions.isNotEmpty) {
        final labels = completions
            .take(10)
            .map(
              (item) => item.label,
            )
            .join(', ');

        _log(
          '[Completion] primeiras sugestões: '
          '$labels',
        );
      }

      _log(
        '[Completion] FIM',
      );

      _log(
        '==================================================',
      );

      return completions;
    } on TimeoutException {
      _log(
        '[Completion] TIMEOUT após 5 segundos.',
      );

      _log(
        '[Completion] FIM COM TIMEOUT',
      );

      _log(
        '==================================================',
      );

      return const <DartCompletionItem>[];
    } catch (
      error,
      stackTrace
    ) {
      _log(
        '[Completion] ERRO: '
        '$error',
      );

      unawaited(
        EditorAutocompleteFileLogger.error(
          'DartAnalysisService.complete',
          error,
        ),
      );

      debugPrint(
        stackTrace.toString(),
      );

      _log(
        '[Completion] FIM COM ERRO',
      );

      _log(
        '==================================================',
      );

      return const <DartCompletionItem>[];
    }
  }

  // ===========================================================================
  // SIGNATURE HELP
  // ===========================================================================

  /// Solicita ao Dart Analysis Server a assinatura da função
  /// ou do construtor na posição atual do cursor.
  ///
  /// [line] e [character] usam posições LSP baseadas em zero.
  ///
  /// [triggerCharacter] pode ser '(' ou ','.
  ///
  /// Retorna o objeto `result` da resposta LSP ou null
  /// quando não existe assinatura disponível ou ocorre erro.
  Future<Map<String, dynamic>?> signatureHelp({
    required String path,
    required int line,
    required int character,
    String? triggerCharacter,
    bool isRetrigger = false,
  }) async {
    _ensureInitialized();

    final normalizedPath =
        _normalizePath(path);

    final serverPath =
        _client.convertPathToServerPath(
      normalizedPath,
    );

    final uri =
        Uri.file(serverPath);

    final uriString =
        uri.toString();

    final safeLine =
        line < 0 ? 0 : line;

    final safeCharacter =
        character < 0 ? 0 : character;

    final isOpen =
        _openDocuments.contains(
      uriString,
    );

    _log(
      '[SignatureHelp] INÍCIO',
    );

    _log(
      '[SignatureHelp] URI: $uriString',
    );

    _log(
      '[SignatureHelp] posição: '
      '$safeLine:$safeCharacter',
    );

    _log(
      '[SignatureHelp] documento aberto: $isOpen',
    );

    _log(
      '[SignatureHelp] triggerCharacter: '
      '$triggerCharacter',
    );

    try {
      final triggerKind =
          triggerCharacter == '(' ||
                  triggerCharacter == ','
              ? 2
              : 1;

      final context =
          <String, dynamic>{
        'triggerKind': triggerKind,
        'isRetrigger': isRetrigger,
      };

      if (triggerCharacter != null &&
          triggerCharacter.isNotEmpty) {
        context['triggerCharacter'] =
            triggerCharacter;
      }

      final response =
          await _client.sendRequest(
        'textDocument/signatureHelp',
        <String, dynamic>{
          'textDocument':
              <String, dynamic>{
            'uri': uriString,
          },
          'position':
              <String, dynamic>{
            'line': safeLine,
            'character': safeCharacter,
          },
          'context': context,
        },
      ).timeout(
        const Duration(seconds: 5),
      );

      final rawResult =
          response['result'];

      if (rawResult is Map) {
        final result =
            Map<String, dynamic>.from(
          rawResult,
        );

        _log(
          '[SignatureHelp] Assinaturas recebidas: '
          '${result['signatures'] is List ? (result['signatures'] as List).length : 0}',
        );

        _log(
          '[SignatureHelp] FIM',
        );

        return result;
      }

      _log(
        '[SignatureHelp] Nenhuma assinatura disponível.',
      );

      return null;
    } on TimeoutException {
      _log(
        '[SignatureHelp] TIMEOUT após 5 segundos.',
      );

      return null;
    } catch (
      error,
      stackTrace
    ) {
      _log(
        '[SignatureHelp] ERRO: $error',
      );

      unawaited(
        EditorAutocompleteFileLogger.error(
          'DartAnalysisService.signatureHelp',
          error,
        ),
      );

      debugPrint(
        stackTrace.toString(),
      );

      return null;
    } finally {
      _log(
        '[SignatureHelp] FIM DA SOLICITAÇÃO',
      );
    }
  }

  List<DartCompletionItem>
      _parseCompletionResult(
    Map<String, dynamic> response,
  ) {
    final rawResult =
        response['result'];

    if (rawResult == null) {
      _log(
        '[Completion] result é null.',
      );

      return const <DartCompletionItem>[];
    }

    List<dynamic> rawItems;

    if (rawResult is List) {
      rawItems = rawResult;
    } else if (rawResult is Map) {
      final items =
          rawResult['items'];

      if (items is! List) {
        _log(
          '[Completion] result é Map, '
          'mas "items" não é List.',
        );

        return const <DartCompletionItem>[];
      }

      rawItems = items;
    } else {
      _log(
        '[Completion] formato de result inesperado: '
        '${rawResult.runtimeType}',
      );

      return const <DartCompletionItem>[];
    }

    final completions =
        <DartCompletionItem>[];

    for (final item in rawItems) {
      if (item is! Map) {
        continue;
      }

      try {
        final completion =
            DartCompletionItem.fromLsp(
          Map<String, dynamic>.from(
            item,
          ),
        );

        if (completion.label.isNotEmpty) {
          completions.add(
            completion,
          );
        }
      } catch (
        error,
        stackTrace
      ) {
        _log(
          '[Completion] ERRO interpretando item: '
          '$error',
        );

        debugPrint(
          stackTrace.toString(),
        );
      }
    }

    return List<DartCompletionItem>.unmodifiable(
      completions,
    );
  }

  Future<void> reanalyze() async {
    _ensureInitialized();

    _log(
      'Solicitando reanálise...',
    );

    _client.sendNotification(
      'dart/reanalyze',
      <String, dynamic>{},
    );
  }

  void _handleNotification(
    Map<String, dynamic> message,
  ) {
    if (_disposed) {
      return;
    }

    final method =
        message['method'];

    if (method is! String) {
      return;
    }

    final params =
        message['params'];

    switch (method) {
      case 'textDocument/publishDiagnostics':
        _handlePublishDiagnostics(
          message,
        );
        break;

      case 'window/logMessage':
        _handleWindowLogMessage(
          message,
        );
        break;

      case 'window/showMessage':
        _log(
          'window/showMessage: $params',
        );
        break;

      case 'telemetry/event':
        _log(
          'telemetry/event: $params',
        );
        break;
    }
  }

  void _handleWindowLogMessage(
    Map<String, dynamic> message,
  ) {
    final params =
        message['params'];

    if (params is! Map) {
      return;
    }

    _log(
      'SERVER LOG [${params['type']}]: '
      '${params['message']}',
    );
  }

  void _handlePublishDiagnostics(
    Map<String, dynamic> message,
  ) {
    final params =
        message['params'];

    if (params is! Map) {
      return;
    }

    final uri =
        params['uri'];

    final diagnosticsValue =
        params['diagnostics'];

    if (uri is! String ||
        diagnosticsValue is! List) {
      return;
    }

    final diagnostics =
        <DartDiagnostic>[];

    for (final item in diagnosticsValue) {
      if (item is! Map) {
        continue;
      }

      try {
        final diagnostic =
            DartDiagnostic.fromLsp(
          uri: uri,
          data:
              Map<String, dynamic>.from(
            item,
          ),
        );

        diagnostics.add(
          diagnostic,
        );

        if (!_diagnosticsController
            .isClosed) {
          _diagnosticsController.add(
            diagnostic,
          );
        }
      } catch (
        error,
        stackTrace
      ) {
        _log(
          'ERRO ao interpretar diagnostic: '
          '$error',
        );

        debugPrint(
          stackTrace.toString(),
        );
      }
    }

    if (!_fileDiagnosticsController
        .isClosed) {
      _fileDiagnosticsController.add(
        DartFileDiagnostics(
          uri: uri,
          diagnostics:
              List<DartDiagnostic>.unmodifiable(
            diagnostics,
          ),
        ),
      );
    }

    _log(
      'publishDiagnostics: '
      '$uri '
      '(${diagnostics.length})',
    );
  }

  void _log(
    String message,
  ) {
    debugPrint(
      '[DartAnalysisService] $message',
    );

    unawaited(
      EditorAutocompleteFileLogger.log(
        '[DartAnalysisService] $message',
      ),
    );
  }

  int _countLines(
    String text,
  ) {
    if (text.isEmpty) {
      return 1;
    }

    var lines = 1;

    for (
      var i = 0;
      i < text.length;
      i++
    ) {
      if (text.codeUnitAt(i) == 10) {
        lines++;
      }
    }

    return lines;
  }

  String _textTail(
    String text,
  ) {
    if (text.isEmpty) {
      return '""';
    }

    const maxLength = 30;

    final start =
        text.length > maxLength
            ? text.length - maxLength
            : 0;

    return '"${text
        .substring(start)
        .replaceAll(
          '\\',
          r'\\',
        )
        .replaceAll(
          '\n',
          r'\n',
        )
        .replaceAll(
          '\r',
          r'\r',
        )
        .replaceAll(
          '\t',
          r'\t',
        )}"';
  }

  void _ensureInitialized() {
    if (_disposed) {
      throw StateError(
        'DartAnalysisService já foi descartado.',
      );
    }

    if (!_initialized ||
        !_client.isRunning) {
      throw StateError(
        'Dart Analysis Server não foi inicializado.',
      );
    }
  }

  int _nextDocumentVersion() {
    _documentVersion++;
    return _documentVersion;
  }

  int _nextDocumentVersionFor(
    String uri,
  ) {
    final current =
        _documentVersions[uri];

    if (current == null) {
      final version =
          _nextDocumentVersion();

      _documentVersions[uri] =
          version;

      return version;
    }

    final version =
        current + 1;

    _documentVersions[uri] =
        version;

    return version;
  }

  String _normalizePath(
    String path,
  ) {
    return File(
      path,
    ).absolute.path;
  }

  String _workspaceName(
    String path,
  ) {
    final normalized =
        path.replaceAll(
      '\\',
      '/',
    );

    final parts =
        normalized.split('/');

    for (
      var i = parts.length - 1;
      i >= 0;
      i--
    ) {
      if (parts[i].isNotEmpty) {
        return parts[i];
      }
    }

    return 'workspace';
  }

  Future<void> stop() async {
    if (_disposed) {
      return;
    }

    _log(
      'Parando serviço...',
    );

    if (_initialized &&
        _client.isRunning) {
      final documents =
          List<String>.from(
        _openDocuments,
      );

      for (final uri in documents) {
        try {
          _client.sendNotification(
            'textDocument/didClose',
            <String, dynamic>{
              'textDocument':
                  <String, dynamic>{
                'uri':
                    uri,
              },
            },
          );
        } catch (error) {
          _log(
            'Erro ao fechar documento '
            '$uri: $error',
          );
        }
      }
    }

    _openDocuments.clear();
    _documentVersions.clear();
    _documentTexts.clear();

    await _notificationSubscription
        ?.cancel();

    _notificationSubscription = null;

    _initialized = false;

    await _client.stop();

    _log(
      'Serviço parado.',
    );
  }

  Future<void> dispose() async {
    if (_disposed) {
      return;
    }

    _disposed = true;
    _initialized = false;

    _openDocuments.clear();
    _documentVersions.clear();
    _documentTexts.clear();

    await _notificationSubscription
        ?.cancel();

    _notificationSubscription = null;

    await _client.dispose();

    if (!_diagnosticsController.isClosed) {
      await _diagnosticsController.close();
    }

    if (!_fileDiagnosticsController.isClosed) {
      await _fileDiagnosticsController.close();
    }

    debugPrint(
      '[DartAnalysisService] Serviço descartado.',
    );

    unawaited(
      EditorAutocompleteFileLogger.log(
        '[DartAnalysisService] Serviço descartado.',
      ),
    );
  }
}

