class DartCompletionPosition {
  final int line;
  final int character;

  const DartCompletionPosition({
    required this.line,
    required this.character,
  });

  factory DartCompletionPosition.fromLsp(
    Map<String, dynamic> data,
  ) {
    return DartCompletionPosition(
      line:
          _toInt(data['line']),
      character:
          _toInt(data['character']),
    );
  }

  @override
  String toString() {
