class DartCompletionItem {
  final String label;
  final int kind;
  final String? detail;
  final String? documentation;
  final String? insertText;
  final int insertTextFormat;
  final String? sortText;
  final String? filterText;
  final bool deprecated;
  final bool preselect;
  final List<String> commitCharacters;
  final DartCompletionTextEdit? textEdit;
  final List<DartCompletionTextEdit>
      additionalTextEdits;

  const DartCompletionItem({
    required this.label,
    required this.kind,
    this.detail,
    this.documentation,
    this.insertText,
    this.insertTextFormat = 1,
    this.sortText,
    this.filterText,
    this.deprecated = false,
    this.preselect = false,
    this.commitCharacters =
        const <String>[],
    this.textEdit,
    this.additionalTextEdits =
        const <DartCompletionTextEdit>[],
  });

  bool get isSnippet =>
      insertTextFormat == 2;

  factory DartCompletionItem.fromLsp(
    Map<String, dynamic> data,
  ) {
    final documentation =
        _completionDocumentation(
      data['documentation'],
    );

    final tags =
        data['tags'];

    final deprecatedByTag =
        tags is List &&
        tags.any(
          (tag) =>
              _toInt(tag) == 1,
        );

    final textEdit =
        _completionTextEdit(
      data['textEdit'],
    );

    final additionalTextEdits =
        _completionAdditionalTextEdits(
      data['additionalTextEdits'],
    );

    final insertText =
        _completionInsertText(
      data,
    );

    final explicitInsertTextFormat =
        _toInt(
      data['insertTextFormat'],
      fallback: 0,
    );

    final insertTextFormat =
        explicitInsertTextFormat != 0
            ? explicitInsertTextFormat
            : _inferCompletionInsertTextFormat(
                insertText,
              );

    return DartCompletionItem(
      label:
          data['label']?.toString() ??
              '',
      kind:
          _toInt(
        data['kind'],
        fallback: 1,
      ),
      detail:
          data['detail']?.toString(),
      documentation:
          documentation,
      insertText:
          insertText,
      insertTextFormat:
          insertTextFormat,
      sortText:
          data['sortText']?.toString(),
      filterText:
          data['filterText']?.toString(),
      deprecated:
          data['deprecated'] == true ||
          deprecatedByTag,
      preselect:
          data['preselect'] == true,
      commitCharacters:
          _completionCommitCharacters(
        data['commitCharacters'],
      ),
      textEdit:
          textEdit,
      additionalTextEdits:
          additionalTextEdits,
    );
  }

  @override
  String toString() {
    return 'DartCompletionItem('
        'label: $label, '
        'kind: $kind, '
        'detail: $detail, '
        'insertText: $insertText, '
        'insertTextFormat: $insertTextFormat, '
        'isSnippet: $isSnippet'
        ')';
  }
}

