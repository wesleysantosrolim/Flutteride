        'line: $line, '
        'character: $character'
        ')';
  }
}

String? _completionInsertText(
  Map<String, dynamic> data,
) {
  final insertText =
      data['insertText'];

  if (insertText is String) {
    return insertText;
  }

  final textEdit =
      data['textEdit'];

  if (textEdit is Map) {
    final newText =
        textEdit['newText'];

    if (newText is String) {
      return newText;
    }
  }

  return null;
}

int _inferCompletionInsertTextFormat(
  String? insertText,
) {
  if (insertText == null ||
      insertText.isEmpty) {
    return 1;
  }

  return _looksLikeLspSnippet(
    insertText,
  )
      ? 2
      : 1;
}

bool _looksLikeLspSnippet(
  String text,
) {
  final indexedPlaceholder =
      RegExp(
    r'\$\{(?:\d+)(?::[^}]*)?\}',
  );

  if (indexedPlaceholder.hasMatch(
    text,
  )) {
    return true;
  }

  final simplePlaceholder =
      RegExp(
    r'\$\d+',
  );

  return simplePlaceholder.hasMatch(
    text,
  );
}

DartCompletionTextEdit? _completionTextEdit(
  dynamic value,
) {
  if (value is! Map) {
    return null;
  }

  try {
    return DartCompletionTextEdit.fromLsp(
      Map<String, dynamic>.from(
        value,
      ),
    );
  } catch (_) {
    return null;
  }
}

List<DartCompletionTextEdit>
    _completionAdditionalTextEdits(
  dynamic value,
) {
  if (value is! List) {
    return const <DartCompletionTextEdit>[];
  }

  final edits =
      <DartCompletionTextEdit>[];

  for (final item in value) {
    if (item is! Map) {
      continue;
    }

    try {
      edits.add(
        DartCompletionTextEdit.fromLsp(
          Map<String, dynamic>.from(
            item,
          ),
        ),
      );
    } catch (_) {}
  }

  return List<DartCompletionTextEdit>.unmodifiable(
    edits,
  );
}

String? _completionDocumentation(
  dynamic value,
) {
  if (value == null) {
    return null;
  }

  if (value is String) {
    return value;
  }

  if (value is Map) {
    final text =
        value['value'];

    if (text is String) {
      return text;
    }
  }

  return value.toString();
}

List<String> _completionCommitCharacters(
  dynamic value,
) {
  if (value is! List) {
    return const <String>[];
  }

  return List<String>.unmodifiable(
    value.whereType<String>(),
  );
}

