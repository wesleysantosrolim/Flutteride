import 'dart:async';
import 'dart:io';

import 'package:flutter/foundation.dart';

import 'dart_lsp_client.dart';
import 'editor_autocomplete_file_logger.dart';

/// Serviço responsável pela integração do flutteride
/// com o Dart Analysis Server.
///
/// Responsabilidades:
/// - iniciar/configurar o Analysis Server;
/// - inicializar o protocolo LSP;
/// - configurar explicitamente o workspace;
/// - abrir documentos;
/// - atualizar documentos;
/// - fechar documentos;
/// - solicitar reanálise;
/// - receber diagnostics;
/// - solicitar completions / IntelliSense;
/// - solicitar Signature Help via LSP;
/// - fornecer diagnostics agrupados por arquivo;
/// - fornecer logs detalhados.
///
/// Não possui nenhuma dependência do Monaco.
class DartAnalysisService {
  DartAnalysisService({
    DartLspClient? client,
  }) : _client = client ??
            DartLspClient(
              enableDebugLogs: true,
            );

  final DartLspClient _client;

  StreamSubscription<Map<String, dynamic>>?
      _notificationSubscription;

  final StreamController<DartDiagnostic>
      _diagnosticsController =
      StreamController<DartDiagnostic>.broadcast();

  final StreamController<DartFileDiagnostics>
      _fileDiagnosticsController =
      StreamController<DartFileDiagnostics>.broadcast();

  bool _initialized = false;
  bool _disposed = false;

  int _documentVersion = 0;

  final Map<String, int> _documentVersions =
      <String, int>{};

  final Map<String, String> _documentTexts =
      <String, String>{};

  final Set<String> _openDocuments =
      <String>{};

  String? _workspacePath;

  Uri? _workspaceUri;

  Stream<Map<String, dynamic>> get notifications =>
      _client.notifications;

  Stream<DartDiagnostic> get diagnostics =>
      _diagnosticsController.stream;

  Stream<DartFileDiagnostics> get fileDiagnostics =>
      _fileDiagnosticsController.stream;

  Stream<String> get serverLogs =>
      _client.serverLogs;

  DartLspClient get client =>
      _client;

  bool get isInitialized =>
      _initialized &&
      !_disposed &&
      _client.isRunning;

  String? get workspacePath =>
      _workspacePath;

  String? get serverWorkspacePath =>
      _client.ubuntuWorkingDirectory;

  Set<String> get openDocuments =>
      Set<String>.unmodifiable(
        _openDocuments,
      );

  Future<void> start({
    required String workspacePath,
  }) async {
    if (_disposed) {
      throw StateError(
        'DartAnalysisService já foi descartado.',
      );
    }

    if (isInitialized) {
      _log(
        'Serviço já está inicializado.',
      );
      return;
    }

    final workspace =
        workspacePath.trim();

    if (workspace.isEmpty) {
      throw ArgumentError(
        'workspacePath não pode ser vazio.',
      );
    }

    _log(
      '==================================================',
    );

    _log(
      'Iniciando DartAnalysisService...',
    );

    _log(
      'workspacePath: $workspace',
    );

    await _notificationSubscription?.cancel();

    _notificationSubscription =
        _client.notifications.listen(
      _handleNotification,
      onError: (
        Object error,
        StackTrace stackTrace,
      ) {
        _log(
          'ERRO no stream de notifications: $error',
        );

        debugPrint(
          stackTrace.toString(),
        );
      },
      onDone: () {
        _log(
          'Stream de notifications encerrado.',
        );
      },
    );

    await _client.start(
      projectPath: workspace,
    );

    _log(
      'Processo do Analysis Server iniciado.',
    );

    if (!_client.isRunning) {
      throw StateError(
        'O processo do Dart Analysis Server '
        'foi iniciado, mas não está em execução.',
      );
    }

    await _initialize(
      rootPath: workspace,
    );

    _log(
      '==================================================',
    );
  }

  Future<void> _initialize({
    required String rootPath,
  }) async {
    if (_disposed) {
      return;
    }

    if (!_client.isRunning) {
      throw StateError(
        'Analysis Server não está em execução.',
      );
    }

    _log(
      'Preparando workspace...',
    );

    final directory =
        Directory(rootPath).absolute;

    _workspacePath =
        directory.path;

    final serverPath =
        _client.convertPathToServerPath(
      directory.path,
    );

    _workspaceUri =
        Uri.directory(
      serverPath,
    );

    final rootUri =
        _workspaceUri;

    _log(
      'Workspace Android:\n'
      '${directory.path}',
    );

    _log(
      'Workspace PRoot:\n'
      '$serverPath',
    );

    _log(
      'Workspace URI LSP:\n'
      '${rootUri.toString()}',
    );

    _log(
      'Workspace existe no processo atual: '
      '${directory.existsSync()}',
    );

    _log(
      'Enviando initialize...',
    );

    await _client.sendRequest(
      'initialize',
      <String, dynamic>{
        'processId': pid,
        'rootUri':
            rootUri.toString(),
        'clientInfo':
            <String, dynamic>{
          'name':
              'flutteride',
          'version':
              '1.0.0',
        },
        'capabilities':
            <String, dynamic>{
          'workspace':
              <String, dynamic>{
            'workspaceFolders':
                true,
            'configuration':
                true,
          },
          'textDocument':
              <String, dynamic>{
            'synchronization':
                <String, dynamic>{
              'dynamicRegistration':
                  false,
              'willSave':
                  false,
              'willSaveWaitUntil':
                  false,
              'didSave':
                  true,
            },
            'completion':
                <String, dynamic>{
              'dynamicRegistration':
                  false,
              'contextSupport':
                  true,
              'completionItem':
                  <String, dynamic>{
                'snippetSupport':
                    true,
                'documentationFormat':
                    <String>[
                  'markdown',
                  'plaintext',
                ],
                'deprecatedSupport':
                    true,
                'preselectSupport':
                    true,
                'tagSupport':
                    <String, dynamic>{
                  'valueSet':
                      <int>[
                    1,
                  ],
                },
              },
            },

            // Capacidades do cliente para Signature Help.
            'signatureHelp':
                <String, dynamic>{
              'dynamicRegistration':
                  false,
              'contextSupport':
                  true,
              'signatureInformation':
                  <String, dynamic>{
                'documentationFormat':
                    <String>[
                  'markdown',
                  'plaintext',
                ],
                'parameterInformation':
                    <String, dynamic>{
                  'labelOffsetSupport':
                      true,
                },
                'activeParameterSupport':
                    true,
              },
            },

            'hover':
                <String, dynamic>{
              'contentFormat':
                  <String>[
                'markdown',
                'plaintext',
              ],
            },
            'definition':
                <String, dynamic>{},
            'references':
                <String, dynamic>{},
            'publishDiagnostics':
                <String, dynamic>{},
          },
        },
        'workspaceFolders':
            <Map<String, dynamic>>[
          <String, dynamic>{
            'uri':
                rootUri.toString(),
            'name':
                _workspaceName(
              serverPath,
            ),
          },
        ],
      },
    );

    if (_disposed) {
      return;
    }

    _log(
      'Resposta do initialize recebida.',
    );

    _log(
      'initialize concluído.',
    );

    _log(
      'Enviando initialized...',
    );

    _client.sendNotification(
      'initialized',
      <String, dynamic>{},
    );

    _log(
      'initialized enviado.',
    );

    _initialized = true;

    await _sendWorkspaceConfiguration();

    _log(
      'LSP inicializado com sucesso.',
    );

    _log(
      'Aguardando notificações do Analysis Server...',
    );
  }

  Future<void> _sendWorkspaceConfiguration() async {
    if (!_initialized ||
        _disposed) {
      return;
    }

    _log(
      'Enviando workspace/didChangeConfiguration...',
    );

    final settings =
        <String, dynamic>{
      'dart':
          <String, dynamic>{
        'analysisServer':
            <String, dynamic>{
          'enabled':
              true,
        },
      },
    };

    _client.sendNotification(
      'workspace/didChangeConfiguration',
      <String, dynamic>{
        'settings':
            settings,
      },
    );

    _log(
      'workspace/didChangeConfiguration enviado.',
    );
  }

  Future<void> openDocument({
    required String path,
    required String text,
    String languageId = 'dart',
  }) async {
    _ensureInitialized();

    final normalizedPath =
        _normalizePath(path);

    final serverPath =
        _client.convertPathToServerPath(
      normalizedPath,
    );

    final uri =
        Uri.file(serverPath);

    final uriString =
        uri.toString();

    if (_openDocuments.contains(
      uriString,
    )) {
      _log(
        'didOpen ignorado: arquivo já está aberto.',
      );

      await changeDocument(
        path: normalizedPath,
        text: text,
      );

      return;
    }

    final version =
        _nextDocumentVersionFor(
      uriString,
    );

    _documentTexts[uriString] =
        text;

    _log(
      '==================================================',
    );

    _log(
      'Enviando didOpen.',
    );

    _log(
      'path Android: '
      '$normalizedPath',
    );

    _log(
      'path PRoot: '
      '$serverPath',
    );

    _log(
      'uri: '
      '$uriString',
    );

    _log(
      'languageId: '
      '$languageId',
    );

    _log(
      'version: '
      '$version',
    );

    unawaited(
      EditorAutocompleteFileLogger.textState(
        source: 'didOpen',
        path: normalizedPath,
        version: version,
        text: text,
      ),
    );

    _client.sendNotification(
      'textDocument/didOpen',
      <String, dynamic>{
        'textDocument':
            <String, dynamic>{
          'uri':
              uriString,
          'languageId':
              languageId,
          'version':
              version,
          'text':
              text,
        },
      },
    );

    _openDocuments.add(
      uriString,
    );

    _log(
      'didOpen enviado com sucesso.',
    );

    _log(
      'Documentos abertos: '
      '${_openDocuments.length}',
    );

    _client.sendNotification(
      'dart/reanalyze',
      <String, dynamic>{},
    );

    _log(
      'dart/reanalyze enviado após didOpen.',
    );

    _log(
      '==================================================',
    );
  }

  Future<void> changeDocument({
    required String path,
    required String text,
  }) async {
    _ensureInitialized();

    final normalizedPath =
        _normalizePath(path);

    final serverPath =
        _client.convertPathToServerPath(
      normalizedPath,
    );

    final uri =
        Uri.file(serverPath);

    final uriString =
        uri.toString();

    if (!_openDocuments.contains(
      uriString,
    )) {
      _log(
        'changeDocument chamado para arquivo '
        'que não está aberto.',
      );

      await openDocument(
        path: normalizedPath,
        text: text,
      );

      return;
    }

    final version =
        _nextDocumentVersionFor(
      uriString,
    );

    _documentTexts[uriString] =
        text;

    _log(
      '==================================================',
    );

    _log(
      'didChange.',
    );

    _log(
      'path Android: '
      '$normalizedPath',
    );

    _log(
      'path PRoot: '
      '$serverPath',
    );

    _log(
      'uri: '
      '$uriString',
    );

    _log(
      'version: '
      '$version',
    );

    unawaited(
      EditorAutocompleteFileLogger.textState(
        source: 'didChange',
        path: normalizedPath,
        version: version,
        text: text,
      ),
    );

    _client.sendNotification(
      'textDocument/didChange',
      <String, dynamic>{
        'textDocument':
            <String, dynamic>{
          'uri':
              uriString,
          'version':
              version,
        },
        'contentChanges':
            <Map<String, dynamic>>[
          <String, dynamic>{
            'text':
                text,
          },
        ],
      },
    );

    _log(
      'didChange enviado.',
    );

    _log(
      '==================================================',
    );
  }

  Future<void> closeDocument(
    String path,
  ) async {
    if (!_initialized ||
        _disposed) {
      return;
    }

    final normalizedPath =
        _normalizePath(path);

    final serverPath =
        _client.convertPathToServerPath(
      normalizedPath,
    );

    final uri =
        Uri.file(serverPath);

    final uriString =
        uri.toString();

    if (!_openDocuments.contains(
      uriString,
    )) {
      return;
    }

    _log(
      'didClose: '
      '$normalizedPath',
    );

    _client.sendNotification(
      'textDocument/didClose',
      <String, dynamic>{
        'textDocument':
            <String, dynamic>{
          'uri':
              uriString,
        },
      },
    );

    _openDocuments.remove(
      uriString,
    );

    _documentVersions.remove(
      uriString,
    );

    _documentTexts.remove(
      uriString,
    );

    _log(
      'didClose enviado.',
    );
  }

